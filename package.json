{
  "name": "aulaescala",
  "version": "0.0.0",
  "private": true,
  "description": "AULAESCALA — plataforma comunitaria de modelismo estatico a escala",
  "repository": {
    "type": "git",
    "url": "https://github.com/elpopi2003/AulaEscala.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @aulaescala/web dev",
    "build": "pnpm --filter @aulaescala/web build",
    "start": "pnpm --filter @aulaescala/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:rls",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "test:rls": "supabase test db"
  },
  "devDependencies": {
    "supabase": "^2.12.1",
    "typescript": "^5.7.3"
  }
}
