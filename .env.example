# ── Supabase ────────────────────────────────────────────────────────────────
# Publicas: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: SOLO en servidor (Edge Functions, webhooks). Nunca con prefijo NEXT_PUBLIC_.
# Salta RLS por completo: §13 — nada se sirve con service_role desde el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MODELISTA=

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@aulaescala.com

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
